# ==============================================================================
# Medicine Reminder & Monitoring System - Environment Configuration Template
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-medicine-reminder-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# ------------------------------------------------------------------------------
# Database Configuration (Dual-Mode Support)
# ------------------------------------------------------------------------------
# Mode 1: Docker Containerized PostgreSQL service (Default with Docker Compose)
#         Set DB_HOST=db
# Mode 2: Existing Windows host PostgreSQL service
#         Set DB_HOST=host.docker.internal
DB_HOST=db
DB_PORT=5432
DB_NAME=medicine_reminder_db
DB_USER=postgres
DB_PASSWORD=postgres

# Medicine Reminder Engine Intervals
MISSED_DOSE_GRACE_MINUTES=120
REMINDER_CHECK_INTERVAL_SECONDS=60
TIME_ZONE=Asia/Kolkata
